#!/bin/sh
# Shared by local builds and release automation.
set -eu
cd "$(dirname "$0")/.."
version="${EVERGREEN_BUILD_VERSION:-$(cat VERSION)}"
if ! printf '%s' "$version" | grep -Eq '^[0-9]+(\.[0-9]+){0,2}$'; then
    printf 'error: expected a valid bundle version\n' >&2
    exit 1
fi
printf '%s\n' "$version"
